# Copy to .env and replace values needed for your environment.
# Generate a Django key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth2; required for Google sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SWD_ADMIN_EMAIL=
DEFAULT_FROM_EMAIL=noreply@example.com

# Optional Amazon SES email delivery. Without these, Django uses console email.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_REGION_NAME=ap-south-1

# Optional Twilio phone-number verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional Web Push. Generate a fresh VAPID key pair before enabling.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional Celery broker; Redis is needed to run background jobs.
REDIS_URL=redis://127.0.0.1:6379/0

# Local defaults. Production must use HTTPS and a restricted host/origin list.
SECURE_SSL_REDIRECT=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
